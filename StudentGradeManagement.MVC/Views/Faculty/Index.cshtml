@model StudentGradeManagement.MVC.ViewModels.FacultyDashboardViewModel
@{
    ViewData["Title"] = "Faculty Portal";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="container py-4">
    <!-- Header Section -->
    <div class="p-4 mb-4 bg-white rounded-3 shadow-sm border d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold text-primary mb-1"><i class="fa-solid fa-chalkboard-user me-2"></i>Faculty Management Portal</h2>
            <p class="text-muted mb-0">Logged in as: <strong>@Model.FacultyName</strong> | Faculty ID: <code>@Model.FacultyId</code></p>
        </div>
        <button class="btn btn-primary px-4 py-2 shadow-sm" onclick="openCreateModal()">
            <i class="fa-solid fa-plus me-2"></i>Add New Grade
        </button>
    </div>

    <!-- Alert Container -->
    <div id="statusAlert"></div>

    <!-- Interactive Table & Search Bar -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-0">
            <h5 class="fw-bold text-secondary mb-0"><i class="fa-solid fa-list me-2"></i>Student Grade Records</h5>
            <div class="w-25">
                <input type="text" id="searchInput" onkeyup="filterTable()" class="form-control form-control-sm" placeholder="🔍 Search student or subject..." />
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="gradesTable">
                    <thead class="table-light">
                        <tr>
                            <th>Student ID</th>
                            <th>Subject Code</th>
                            <th>Subject Name</th>
                            <th>Grade</th>
                            <th>Remarks</th>
                            <th>Semester</th>
                            <th>School Year</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="facultyGradesTableBody">
                        <!-- Dynamically populated via Fetch API -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Form -->
<div class="modal fade" id="gradeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalTitle"><i class="fa-solid fa-pen-to-square me-2"></i>Grade Record</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="gradeId" value="0" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Student ID</label>
                        <input type="text" id="studentId" class="form-control" placeholder="202310123" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Numerical Grade (0-100)</label>
                        <input type="number" id="grade" class="form-control" min="0" max="100" placeholder="0-100" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Subject Code</label>
                        <input type="text" id="subjectCode" class="form-control" placeholder="IT101" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Subject Name</label>
                        <input type="text" id="subjectName" class="form-control" placeholder="Web Development" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Semester</label>
                        <input type="text" id="semester" class="form-control" placeholder="1st Semester" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">School Year</label>
                        <input type="text" id="schoolYear" class="form-control" placeholder="2025-2026" required />
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary px-4" onclick="saveGrade()">Save Record</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL = "https://localhost:7001/api/grades";

        document.addEventListener("DOMContentLoaded", loadGrades);

        async function loadGrades() {
            try {
                const response = await fetch(API_URL);
                if (!response.ok) throw new Error("Failed to load records.");
                const grades = await response.json();

                const tbody = document.getElementById("facultyGradesTableBody");
                tbody.innerHTML = "";

                if (grades.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="8" class="text-center py-4 text-muted">No grade records found.</td></tr>`;
                    return;
                }

                grades.forEach(g => {
                    tbody.innerHTML += `
                        <tr>
                            <td><span class="badge bg-light text-dark border">${g.studentId}</span></td>
                            <td class="fw-semibold">${g.subjectCode}</td>
                            <td>${g.subjectName}</td>
                            <td><span class="fs-6 fw-bold text-primary">${g.grade}</span></td>
                            <td><span class="badge ${getBadgeStyle(g.remarks)}">${g.remarks}</span></td>
                            <td>${g.semester}</td>
                            <td>${g.schoolYear}</td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-warning me-1" onclick="editGrade(${g.gradeId})"><i class="fa-solid fa-pen"></i> Edit</button>
                                <button class="btn btn-sm btn-outline-danger" onclick="deleteGrade(${g.gradeId})"><i class="fa-solid fa-trash"></i> Delete</button>
                            </td>
                        </tr>`;
                });
            } catch (err) {
                showAlert("Error loading grade records from API.", "danger");
            }
        }

        function openCreateModal() {
            document.getElementById("gradeId").value = "0";
            document.getElementById("studentId").value = "";
            document.getElementById("subjectCode").value = "";
            document.getElementById("subjectName").value = "";
            document.getElementById("grade").value = "";
            document.getElementById("semester").value = "";
            document.getElementById("schoolYear").value = "";
            document.getElementById("modalTitle").innerHTML = '<i class="fa-solid fa-plus me-2"></i>Add Grade Record';
            new bootstrap.Modal(document.getElementById("gradeModal")).show();
        }

        async function editGrade(id) {
            const res = await fetch(`${API_URL}/${id}`);
            if (!res.ok) return showAlert("Unable to find record.", "danger");
            const g = await res.json();

            document.getElementById("gradeId").value = g.gradeId;
            document.getElementById("studentId").value = g.studentId;
            document.getElementById("subjectCode").value = g.subjectCode;
            document.getElementById("subjectName").value = g.subjectName;
            document.getElementById("grade").value = g.grade;
            document.getElementById("semester").value = g.semester;
            document.getElementById("schoolYear").value = g.schoolYear;
            document.getElementById("modalTitle").innerHTML = '<i class="fa-solid fa-pen me-2"></i>Edit Grade Record';
            new bootstrap.Modal(document.getElementById("gradeModal")).show();
        }

        async function saveGrade() {
            const id = parseInt(document.getElementById("gradeId").value);
            const payload = {
                studentId: document.getElementById("studentId").value,
                subjectCode: document.getElementById("subjectCode").value,
                subjectName: document.getElementById("subjectName").value,
                grade: parseInt(document.getElementById("grade").value),
                semester: document.getElementById("semester").value,
                schoolYear: document.getElementById("schoolYear").value
            };

            const method = id === 0 ? "POST" : "PUT";
            const url = id === 0 ? API_URL : `${API_URL}/${id}`;

            const res = await fetch(url, {
                method: method,
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload)
            });

            if (res.ok) {
                showAlert(id === 0 ? "Grade added successfully!" : "Grade updated successfully!", "success");
                bootstrap.Modal.getInstance(document.getElementById("gradeModal")).hide();
                loadGrades();
            } else {
                const err = await res.json();
                showAlert(err.message || "Failed to save record.", "danger");
            }
        }

        async function deleteGrade(id) {
            if (!confirm("Are you sure you want to delete this grade record?")) return;

            const res = await fetch(`${API_URL}/${id}`, { method: "DELETE" });
            if (res.ok) {
                showAlert("Record deleted successfully.", "success");
                loadGrades();
            } else {
                showAlert("Failed to delete record.", "danger");
            }
        }

        function filterTable() {
            const query = document.getElementById("searchInput").value.toLowerCase();
            const rows = document.querySelectorAll("#facultyGradesTableBody tr");
            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                row.style.display = text.includes(query) ? "" : "none";
            });
        }

        function getBadgeStyle(remark) {
            if (remark === "BEP/FAILED") return "bg-danger";
            if (remark === "CMS" || remark === "SP") return "bg-success";
            return "bg-primary";
        }

        function showAlert(msg, type) {
            document.getElementById("statusAlert").innerHTML = `
                <div class="alert alert-${type} alert-dismissible fade show shadow-sm" role="alert">
                    ${msg}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>`;
        }
    </script>
}