@model StudentGradeManagement.MVC.ViewModels.FacultyDashboardViewModel
@{
    ViewData["Title"] = "Faculty Portal";
}

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h3 class="fw-bold text-dark mb-1"><i class="fa-solid fa-chalkboard-user text-primary me-2"></i>Faculty Dashboard</h3>
            <p class="text-muted mb-0">Welcome, <strong>@Model.FacultyName</strong> &middot; Faculty ID: <code>@Model.FacultyId</code></p>
        </div>
        <button class="btn btn-primary px-4 shadow-sm" onclick="openCreateModal()">
            <i class="fa-solid fa-plus me-2"></i>Add New Grade
        </button>
    </div>

    <!-- Summary cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-4">
            <div class="card border-0 shadow-sm summary-card h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="summary-icon bg-primary-subtle text-primary"><i class="fa-solid fa-user-graduate"></i></div>
                    <div class="ms-3">
                        <div class="text-muted small text-uppercase fw-semibold">Students Graded</div>
                        <div class="fs-3 fw-bold" id="cardStudents">0</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-4">
            <div class="card border-0 shadow-sm summary-card h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="summary-icon bg-success-subtle text-success"><i class="fa-solid fa-file-lines"></i></div>
                    <div class="ms-3">
                        <div class="text-muted small text-uppercase fw-semibold">Total Grade Records</div>
                        <div class="fs-3 fw-bold" id="cardRecords">0</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-12 col-lg-4">
            <div class="card border-0 shadow-sm summary-card h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="summary-icon bg-warning-subtle text-warning"><i class="fa-solid fa-book"></i></div>
                    <div class="ms-3">
                        <div class="text-muted small text-uppercase fw-semibold">Subjects</div>
                        <div class="fs-3 fw-bold" id="cardSubjects">0</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters + table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 border-bottom">
            <div class="row g-2 align-items-center">
                <div class="col-lg-3 col-md-6">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light"><i class="fa-solid fa-magnifying-glass"></i></span>
                        <input type="text" id="searchInput" class="form-control" placeholder="Search name or student no." oninput="applyFilters()" />
                    </div>
                </div>
                <div class="col-lg-2 col-md-6">
                    <select id="filterSubject" class="form-select form-select-sm" onchange="applyFilters()"><option value="">All Subjects</option></select>
                </div>
                <div class="col-lg-2 col-md-4">
                    <select id="filterSemester" class="form-select form-select-sm" onchange="applyFilters()"><option value="">All Semesters</option></select>
                </div>
                <div class="col-lg-2 col-md-4">
                    <select id="filterSchoolYear" class="form-select form-select-sm" onchange="applyFilters()"><option value="">All School Years</option></select>
                </div>
                <div class="col-lg-2 col-md-4">
                    <select id="filterRemarks" class="form-select form-select-sm" onchange="applyFilters()">
                        <option value="">All Remarks</option>
                        <option value="CMS">CMS</option>
                        <option value="SP">SP</option>
                        <option value="SAP">SAP</option>
                        <option value="GP">GP</option>
                        <option value="EP">EP</option>
                        <option value="BEP/FAILED">BEP/FAILED</option>
                    </select>
                </div>
                <div class="col-lg-1 col-md-4 text-end">
                    <button class="btn btn-sm btn-outline-secondary w-100" onclick="resetFilters()" title="Reset filters"><i class="fa-solid fa-rotate-left"></i></button>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="gradesTable">
                    <thead class="table-light">
                        <tr>
                            <th>Student No.</th>
                            <th>Student Name</th>
                            <th>Subj Code</th>
                            <th>Subject Name</th>
                            <th>Faculty</th>
                            <th class="text-center">Grade</th>
                            <th class="text-center">Remarks</th>
                            <th>Semester</th>
                            <th>School Year</th>
                            <th>Date Posted</th>
                            <th>Date Modified</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="gradesTableBody"></tbody>
                </table>
            </div>
            <div id="loadingState" class="text-center py-5 d-none">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="text-muted mt-2 mb-0">Loading grade records...</p>
            </div>
            <div id="emptyState" class="text-center py-5 d-none">
                <i class="fa-regular fa-folder-open fa-2x text-muted mb-2"></i>
                <p class="text-muted mb-0">No grade records match your filters.</p>
            </div>
        </div>
        <div class="card-footer bg-white text-muted small" id="tableFooter"></div>
    </div>
</div>

<!-- Add / Edit modal -->
<div class="modal fade" id="gradeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalTitle"><i class="fa-solid fa-pen-to-square me-2"></i>Grade Record</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="gradeId" value="0" />
                <div id="modalError" class="alert alert-danger d-none py-2"></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Student Number</label>
                        <input type="text" id="studentNumber" class="form-control" placeholder="2026-0001" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Numerical Grade (0-100, whole)</label>
                        <input type="number" id="grade" class="form-control" min="0" max="100" step="1" placeholder="0-100" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Subject Code</label>
                        <input type="text" id="subjectCode" class="form-control" placeholder="IPT101" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Subject Name</label>
                        <input type="text" id="subjectName" class="form-control" placeholder="Integrative Programming Technologies" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Semester</label>
                        <input type="text" id="semester" class="form-control" placeholder="1st Semester" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">School Year</label>
                        <input type="text" id="schoolYear" class="form-control" placeholder="2026-2027" />
                    </div>
                </div>
                <small class="text-muted d-block mt-3"><i class="fa-solid fa-circle-info me-1"></i>Remarks are calculated automatically by the server from the grade.</small>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary px-4" id="saveBtn" onclick="saveGrade()">Save Record</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete confirmation modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fa-solid fa-triangle-exclamation me-2"></i>Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-1">Delete this grade record permanently?</p>
                <p class="text-muted mb-0" id="deleteInfo"></p>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger px-4" id="confirmDeleteBtn"><i class="fa-solid fa-trash me-1"></i>Delete</button>
            </div>
        </div>
    </div>
</div>

<!-- Toast container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" id="toastContainer"></div>

@section Scripts {
    <script>
        const API_URL = "https://localhost:7001/api/grades";
        const jwtToken = "@Context.Session.GetString("JWToken")";

        let allGrades = [];
        let pendingDeleteId = null;

        document.addEventListener("DOMContentLoaded", loadGrades);

        function authHeaders(json) {
            const h = { "Authorization": `Bearer ${jwtToken}` };
            if (json) h["Content-Type"] = "application/json";
            return h;
        }

        async function loadGrades() {
            showLoading(true);
            try {
                const res = await fetch(API_URL, { headers: authHeaders(false) });
                if (res.status === 401) { redirectLogin(); return; }
                if (!res.ok) throw new Error("Failed to load records.");
                allGrades = await res.json();
                populateFilterOptions();
                updateSummary();
                applyFilters();
            } catch (err) {
                toast(err.message || "Error loading grade records.", "danger");
                document.getElementById("gradesTableBody").innerHTML = "";
            } finally {
                showLoading(false);
            }
        }

        function updateSummary() {
            const students = new Set(allGrades.map(g => g.studentNumber));
            const subjects = new Set(allGrades.map(g => g.subjectCode));
            document.getElementById("cardStudents").textContent = students.size;
            document.getElementById("cardRecords").textContent = allGrades.length;
            document.getElementById("cardSubjects").textContent = subjects.size;
        }

        function populateFilterOptions() {
            fillSelect("filterSubject", [...new Set(allGrades.map(g => g.subjectCode))], "All Subjects");
            fillSelect("filterSemester", [...new Set(allGrades.map(g => g.semester))], "All Semesters");
            fillSelect("filterSchoolYear", [...new Set(allGrades.map(g => g.schoolYear))], "All School Years");
        }

        function fillSelect(id, values, allLabel) {
            const sel = document.getElementById(id);
            const current = sel.value;
            sel.innerHTML = `<option value="">${allLabel}</option>`;
            values.filter(v => v).sort().forEach(v => {
                const opt = document.createElement("option");
                opt.value = v; opt.textContent = v;
                sel.appendChild(opt);
            });
            sel.value = current;
        }

        function applyFilters() {
            const q = document.getElementById("searchInput").value.toLowerCase().trim();
            const subj = document.getElementById("filterSubject").value;
            const sem = document.getElementById("filterSemester").value;
            const sy = document.getElementById("filterSchoolYear").value;
            const rem = document.getElementById("filterRemarks").value;

            const filtered = allGrades.filter(g =>
                (!q || (g.studentName || "").toLowerCase().includes(q) || (g.studentNumber || "").toLowerCase().includes(q)) &&
                (!subj || g.subjectCode === subj) &&
                (!sem || g.semester === sem) &&
                (!sy || g.schoolYear === sy) &&
                (!rem || g.remarks === rem)
            );
            renderTable(filtered);
        }

        function resetFilters() {
            ["searchInput","filterSubject","filterSemester","filterSchoolYear","filterRemarks"].forEach(id => document.getElementById(id).value = "");
            applyFilters();
        }

        function renderTable(grades) {
            const tbody = document.getElementById("gradesTableBody");
            const empty = document.getElementById("emptyState");
            tbody.innerHTML = "";

            if (!grades.length) {
                empty.classList.remove("d-none");
                document.getElementById("tableFooter").textContent = "0 records";
                return;
            }
            empty.classList.add("d-none");

            grades.forEach(g => {
                tbody.insertAdjacentHTML("beforeend", `
                    <tr>
                        <td><span class="badge bg-light text-dark border">${esc(g.studentNumber)}</span></td>
                        <td class="fw-semibold">${esc(g.studentName)}</td>
                        <td>${esc(g.subjectCode)}</td>
                        <td>${esc(g.subjectName)}</td>
                        <td class="text-muted small">${esc(g.facultyName)}</td>
                        <td class="text-center fw-bold">${g.grade}</td>
                        <td class="text-center"><span class="badge ${badge(g.remarks)}">${esc(g.remarks)}</span></td>
                        <td class="small">${esc(g.semester)}</td>
                        <td class="small">${esc(g.schoolYear)}</td>
                        <td class="small text-muted">${fmtDate(g.datePosted)}</td>
                        <td class="small text-muted">${fmtDate(g.dateModified)}</td>
                        <td class="text-center text-nowrap">
                            <button class="btn btn-sm btn-outline-primary me-1" onclick="editGrade(${g.gradeId})" title="Edit"><i class="fa-solid fa-pen"></i></button>
                            <button class="btn btn-sm btn-outline-danger" onclick="askDelete(${g.gradeId})" title="Delete"><i class="fa-solid fa-trash"></i></button>
                        </td>
                    </tr>`);
            });
            document.getElementById("tableFooter").textContent = `${grades.length} of ${allGrades.length} record(s)`;
        }

        function openCreateModal() {
            document.getElementById("gradeId").value = "0";
            ["studentNumber","subjectCode","subjectName","grade"].forEach(id => document.getElementById(id).value = "");
            document.getElementById("semester").value = "1st Semester";
            document.getElementById("schoolYear").value = "2026-2027";
            document.getElementById("studentNumber").disabled = false;
            document.getElementById("modalTitle").innerHTML = '<i class="fa-solid fa-plus me-2"></i>Add Grade Record';
            hideModalError();
            new bootstrap.Modal(document.getElementById("gradeModal")).show();
        }

        async function editGrade(id) {
            try {
                const res = await fetch(`${API_URL}/${id}`, { headers: authHeaders(false) });
                if (!res.ok) return toast("Unable to load record.", "danger");
                const g = await res.json();
                document.getElementById("gradeId").value = g.gradeId;
                document.getElementById("studentNumber").value = g.studentNumber;
                document.getElementById("studentNumber").disabled = true; // keep ownership stable on edit
                document.getElementById("subjectCode").value = g.subjectCode;
                document.getElementById("subjectName").value = g.subjectName;
                document.getElementById("grade").value = g.grade;
                document.getElementById("semester").value = g.semester;
                document.getElementById("schoolYear").value = g.schoolYear;
                document.getElementById("modalTitle").innerHTML = '<i class="fa-solid fa-pen me-2"></i>Edit Grade Record';
                hideModalError();
                new bootstrap.Modal(document.getElementById("gradeModal")).show();
            } catch { toast("Network error loading record.", "danger"); }
        }

        async function saveGrade() {
            const id = parseInt(document.getElementById("gradeId").value);
            const gradeVal = document.getElementById("grade").value;
            const payload = {
                studentNumber: document.getElementById("studentNumber").value.trim(),
                subjectCode: document.getElementById("subjectCode").value.trim(),
                subjectName: document.getElementById("subjectName").value.trim(),
                grade: gradeVal === "" ? null : Number(gradeVal),
                semester: document.getElementById("semester").value.trim(),
                schoolYear: document.getElementById("schoolYear").value.trim()
            };

            // light client-side hints (server is the source of truth)
            if (!payload.studentNumber || !payload.subjectCode || !payload.subjectName || !payload.semester || !payload.schoolYear) {
                return showModalError("All fields are required.");
            }

            const btn = document.getElementById("saveBtn");
            btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Saving...';

            try {
                const res = await fetch(id === 0 ? API_URL : `${API_URL}/${id}`, {
                    method: id === 0 ? "POST" : "PUT",
                    headers: authHeaders(true),
                    body: JSON.stringify(payload)
                });

                if (res.ok) {
                    bootstrap.Modal.getInstance(document.getElementById("gradeModal")).hide();
                    toast(id === 0 ? "Grade added successfully." : "Grade updated successfully.", "success");
                    await loadGrades();
                } else {
                    showModalError(await errorMessage(res));
                }
            } catch {
                showModalError("Network error. Please try again.");
            } finally {
                btn.disabled = false; btn.innerHTML = "Save Record";
            }
        }

        function askDelete(id) {
            pendingDeleteId = id;
            const g = allGrades.find(x => x.gradeId === id);
            document.getElementById("deleteInfo").textContent = g ? `${g.studentName} - ${g.subjectCode} (${g.semester}, ${g.schoolYear})` : "";
            new bootstrap.Modal(document.getElementById("deleteModal")).show();
        }

        document.getElementById("confirmDeleteBtn").addEventListener("click", async () => {
            if (!pendingDeleteId) return;
            try {
                const res = await fetch(`${API_URL}/${pendingDeleteId}`, { method: "DELETE", headers: authHeaders(false) });
                bootstrap.Modal.getInstance(document.getElementById("deleteModal")).hide();
                if (res.ok) { toast("Record deleted.", "success"); await loadGrades(); }
                else toast(await errorMessage(res), "danger");
            } catch { toast("Network error deleting record.", "danger"); }
            finally { pendingDeleteId = null; }
        });

        // ---------- helpers ----------
        async function errorMessage(res) {
            try { const j = await res.json(); return j.message || j.title || `Request failed (${res.status}).`; }
            catch { return `Request failed (${res.status}).`; }
        }
        function showLoading(on) {
            document.getElementById("loadingState").classList.toggle("d-none", !on);
            if (on) { document.getElementById("gradesTableBody").innerHTML = ""; document.getElementById("emptyState").classList.add("d-none"); }
        }
        function showModalError(msg){ const e=document.getElementById("modalError"); e.textContent=msg; e.classList.remove("d-none"); }
        function hideModalError(){ document.getElementById("modalError").classList.add("d-none"); }
        function redirectLogin(){ window.location.href = "/Account/Login"; }
        function badge(r){ if(r==="BEP/FAILED")return "bg-danger"; if(r==="CMS"||r==="SP")return "bg-success"; if(r==="SAP"||r==="GP")return "bg-primary"; return "bg-secondary"; }
        function fmtDate(d){ if(!d) return "-"; const dt=new Date(d); return isNaN(dt)?"-":dt.toLocaleDateString(undefined,{year:"numeric",month:"short",day:"numeric"}); }
        function esc(s){ return (s==null?"":String(s)).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c])); }
        function toast(msg, type){
            const id = "t" + Date.now();
            const colors = { success:"text-bg-success", danger:"text-bg-danger", info:"text-bg-primary", warning:"text-bg-warning" };
            document.getElementById("toastContainer").insertAdjacentHTML("beforeend", `
                <div id="${id}" class="toast align-items-center ${colors[type]||colors.info} border-0" role="alert">
                    <div class="d-flex"><div class="toast-body">${esc(msg)}</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div>
                </div>`);
            const el = document.getElementById(id);
            const t = new bootstrap.Toast(el, { delay: 3500 }); t.show();
            el.addEventListener("hidden.bs.toast", () => el.remove());
        }
    </script>
}
