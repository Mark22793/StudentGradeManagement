@model StudentGradeManagement.MVC.ViewModels.StudentDashboardViewModel
@{
    ViewData["Title"] = "Student Portal";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="container py-4">
    <!-- Header Card -->
    <div class="p-4 mb-4 bg-white rounded-3 shadow-sm border">
        <h2 class="fw-bold text-success mb-1"><i class="fa-solid fa-user-graduate me-2"></i>Student Portal</h2>
        <p class="text-muted mb-0">Student Name: <strong>@Model.StudentName</strong> | Student ID: <code>@Model.StudentId</code></p>
    </div>

    <div id="statusAlert"></div>

    <!-- Grade Report Card -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 border-0">
            <h5 class="fw-bold text-secondary mb-0"><i class="fa-solid fa-file-invoice me-2"></i>Academic Performance & Remarks</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Subject Code</th>
                            <th>Subject Name</th>
                            <th>Grade</th>
                            <th>Remarks</th>
                            <th>Semester</th>
                            <th>School Year</th>
                        </tr>
                    </thead>
                    <tbody id="studentGradesTableBody">
                        <!-- Dynamically populated via Fetch API -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", fetchMyGrades);

        async function fetchMyGrades() {
            const tbody = document.getElementById("studentGradesTableBody");
            const alertDiv = document.getElementById("statusAlert");
            tbody.innerHTML = "";
            alertDiv.innerHTML = "";

            try {
                const response = await fetch("https://localhost:7001/api/student/grades");

                if (response.status === 401) {
                    alertDiv.innerHTML = `<div class="alert alert-danger shadow-sm"><i class="fa-solid fa-lock me-2"></i>Unauthorized access. Please log in again.</div>`;
                    return;
                }

                if (response.status === 403) {
                    alertDiv.innerHTML = `<div class="alert alert-warning shadow-sm"><i class="fa-solid fa-ban me-2"></i>Forbidden: You do not have permission to view these grades.</div>`;
                    return;
                }

                if (!response.ok) {
                    throw new Error("Unable to fetch grade records.");
                }

                const grades = await response.json();

                if (grades.length === 0) {
                    alertDiv.innerHTML = `<div class="alert alert-info shadow-sm"><i class="fa-solid fa-info-circle me-2"></i>No grade records found for your account.</div>`;
                    return;
                }

                grades.forEach(g => {
                    tbody.innerHTML += `
                        <tr>
                            <td class="fw-semibold">${g.subjectCode}</td>
                            <td>${g.subjectName}</td>
                            <td><span class="fs-6 fw-bold text-success">${g.grade}</span></td>
                            <td><span class="badge ${getBadgeStyle(g.remarks)}">${g.remarks}</span></td>
                            <td>${g.semester}</td>
                            <td>${g.schoolYear}</td>
                        </tr>`;
                });

            } catch (err) {
                alertDiv.innerHTML = `<div class="alert alert-danger shadow-sm">${err.message}</div>`;
            }
        }

        function getBadgeStyle(remark) {
            if (remark === "BEP/FAILED") return "bg-danger";
            if (remark === "CMS" || remark === "SP") return "bg-success";
            return "bg-primary";
        }
    </script>
}